<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark surface needs light status-bar icons; values/themes.xml sets true. -->
    <style name="Theme.ZCodeMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zc_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
